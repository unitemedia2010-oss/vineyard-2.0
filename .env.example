# VINEYARD 2.0 Environment Configuration
# Copy this file to .env and adjust if necessary

# Target Website Configuration
VINEYARD_BASE_URL=https://vineyard.vn
VINEYARD_USER_AGENT="VineyardAuditBot/2.0 (+https://vineyard.vn/robots.txt; security-audit-local-research)"

# Crawler Settings
CRAWLER_CONCURRENCY=2
CRAWLER_RATE_LIMIT_DELAY=1.5
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3
CRAWLER_RETRY_BACKOFF=2.0
CRAWLER_RESUME=true
CRAWLER_DRY_RUN=false
CRAWLER_CACHE_ENABLED=true

# Storage Paths
DATABASE_PATH=data/database/vineyard.db
RAW_DATA_PATH=data/raw
NORMALIZED_DATA_PATH=data/normalized
ASSETS_PATH=data/assets
SCREENSHOTS_PATH=data/screenshots
REPORTS_PATH=data/reports

# Playwright Settings
HEADLESS=true
VIEWPORT_DESKTOP_WIDTH=1440
VIEWPORT_DESKTOP_HEIGHT=900
VIEWPORT_TABLET_WIDTH=768
VIEWPORT_TABLET_HEIGHT=1024
VIEWPORT_MOBILE_WIDTH=390
VIEWPORT_MOBILE_HEIGHT=844
